# 数据库
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=ailan
DB_SCHEMA=lessonPlanAi
DB_STATEMENTS_TIMEOUT=60

# 服务
PORT=6586
API_PREFIX=api
MAX_JSON_BODY_BYTES=2097152
# 允许跨域的前端来源，逗号分隔；令牌走 Authorization 头，不需要 allow_credentials
CORS_ORIGINS=http://localhost:3000

# 登录令牌
JWT_SECRET=
# 有效期秒数，默认 7 天
JWT_EXPIRES_IN=604800

# 邮件验证码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 对象存储（四项齐全才会启用，缺省时图片以 bytea 存库）
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true

# AI：模型参数（baseUrl / apiKey / 模型名）存在 ai_assistant_config 表里，这里只放进程级的兜底与追踪
LLM_FALLBACK_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_RETRY_ATTEMPTS=3
# 结构化产出（模板识别、模板改写）单次调用的 token 下限：思考型模型会把预算烧在推理上
LLM_STRUCTURED_MAX_TOKENS=16384
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ailan-agent

# 课件预览渲染
PPT_PREVIEW_DIR=
